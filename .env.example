# NEXUS runs fully without any keys (simulated + reference datasets).
# Add keys to .env.local to enable live sources. Keys are read ONLY on the server
# (Next.js route handlers) and are never sent to the browser.

# Finnhub (https://finnhub.io) — live quotes for US equities & ETFs
FINNHUB_API_KEY=

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html) — live macro series
FRED_API_KEY=

# SEC EDGAR XBRL company facts — no key, but the SEC requires a descriptive
# User-Agent with contact info, e.g. "NEXUS Research you@example.com"
SEC_USER_AGENT=
